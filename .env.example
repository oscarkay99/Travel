# Five independently managed Gemini projects (first healthy project wins)
AI_PROVIDER_ORDER=gemini_project_1,gemini_project_2,gemini_project_3,gemini_project_4,gemini_project_5
AI_MODEL_TIMEOUT_MS=7000
AI_PROVIDER_COOLDOWN_MS=60000

# Store real keys only in the deployment secret manager. Each key should belong
# to its corresponding authorized Google Cloud project.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Shared model order. GEMINI_MODELS_1 through GEMINI_MODELS_5 can override this
# list for an individual project.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Existing application services
NODE_ENV=production
RESEND_API_KEY=
TO_EMAIL=akwaabatoursa@gmail.com
SUPA_URL=http://supa-kong:8000
SUPA_SERVICE_KEY=

# Optional dedicated HMAC key for rate-limit and duplicate fingerprints. When
# omitted, the server-side Supabase service key is used. Generate at least 32
# random bytes and never expose this value to the browser.
RATE_LIMIT_HASH_SECRET=

# Cloudflare Turnstile bot protection. The site key is public; the secret key
# must remain server-side. Protection activates only when both are configured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
